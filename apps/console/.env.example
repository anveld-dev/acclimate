# Server-only runtime configuration. Supply explicitly; never prefix secrets with VITE_.
# Build is secret-free. Copy this template to a private location outside the checkout.
# Keycloak OIDC configuration; see deploy/sign-in.md.
# Replace example.com with your owned domain; keep /realms/acclimate in the issuer.
CONSOLE_ORIGIN=https://console.example.com
CONSOLE_SERVICE_URL=http://service:3000
CONSOLE_PUBLIC_API_URL=https://api.example.com
CONSOLE_OIDC_ISSUER=https://auth.example.com/realms/acclimate
CONSOLE_OIDC_CLIENT_ID=acclimate-console
CONSOLE_OIDC_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# Exact matching credentials in service.env; distinct from each other and all machine grants.
CONSOLE_LOGIN_TOKEN=REPLACE_WITH_LOGIN_AUTHORITY_TOKEN
CONSOLE_SERVICE_TOKEN=REPLACE_WITH_CONSOLE_TRANSPORT_TOKEN
# Deliberate authoring enablement; current workspace editor/admin permissions still apply.
CONSOLE_ALLOW_EDITS=true
