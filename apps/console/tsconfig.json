{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@acclimate/sdk": ["../../packages/sdk/src/index.ts"],
      "@acclimate/sdk/validation": ["../../packages/sdk/src/validation.ts"],
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src", "tests", "vite.config.ts"]
}
