{
	email {$ACME_EMAIL}
}

{$CONSOLE_HOST} {
	reverse_proxy console:3100 {
		header_up Host {$CONSOLE_HOST}
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$CONSOLE_HOST}
		header_up X-Forwarded-For {remote_host}
	}
}

{$API_HOST} {
	@task_import path /v1/workspaces/*/bundles/*/learning/tasks/import
	request_body @task_import {
		max_size 67108864
	}
	reverse_proxy service:3000 {
		header_up Host {$API_HOST}
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$API_HOST}
		header_up X-Forwarded-For {remote_host}
	}
}
