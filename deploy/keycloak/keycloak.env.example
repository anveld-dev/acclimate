# Private runtime configuration, mode 0600. Never committed after completion.
# KC_DB_PASSWORD must match the separate keycloak_postgres_password secret file.
KC_DB_PASSWORD=REPLACE_WITH_KEYCLOAK_DATABASE_PASSWORD
# Temporary bootstrap identity administrator; separate from an Acclimate operator.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_BOOTSTRAP_ADMIN_PASSWORD
# Used by first-time realm import. Must match the console configuration exactly.
ACCLIMATE_CONSOLE_ORIGIN=https://console.example.com
ACCLIMATE_OIDC_CLIENT_SECRET=REPLACE_WITH_CONSOLE_OIDC_CLIENT_SECRET
# Review CPU/memory limits for the intended host before deployment.
