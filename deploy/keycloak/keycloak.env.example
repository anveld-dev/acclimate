# Private runtime file, mode 0600. deploy/init.sh writes it; never commit a completed copy.
# KC_DB_PASSWORD must match the separate keycloak-postgres-password file.
KC_DB_PASSWORD=REPLACE_WITH_KEYCLOAK_DATABASE_PASSWORD
# Read once, by the first realm import. The console origin must match the console configuration exactly.
ACCLIMATE_CONSOLE_ORIGIN=https://console.example.com
ACCLIMATE_OIDC_CLIENT_SECRET=REPLACE_WITH_CONSOLE_OIDC_CLIENT_SECRET
# The first person: the UUID in ACCLIMATE_OPERATORS, their email and a temporary password.
ACCLIMATE_FIRST_USER_ID=REPLACE_WITH_UUID
ACCLIMATE_FIRST_USER_EMAIL=you@example.com
ACCLIMATE_FIRST_USER_PASSWORD=REPLACE_WITH_TEMPORARY_PASSWORD
