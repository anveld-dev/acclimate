# Private runtime file, mode 0600. Replace placeholders; do not commit a completed copy.
# Password must match the externally supplied PostgreSQL secret, URL-encoded here.
DATABASE_URL=postgresql://acclimate:REPLACE_WITH_ENCODED_PASSWORD@postgres:5432/acclimate
# Service default is 127.0.0.1:3000; Compose needs a container-reachable bind.
ACCLIMATE_BIND=0.0.0.0:3000
# Issuer must match CONSOLE_OIDC_ISSUER verbatim, including any trailing slash.
ACCLIMATE_OIDC_ISSUER=https://auth.example.com/realms/acclimate
ACCLIMATE_LOGIN_TOKEN=REPLACE_WITH_LOGIN_AUTHORITY_TOKEN
ACCLIMATE_CONSOLE_TOKEN=REPLACE_WITH_DIFFERENT_CONSOLE_TRANSPORT_TOKEN
# Exact issuer/subject pairs. Operator capability alone grants no workspace membership.
ACCLIMATE_OPERATORS=[{"issuer":"https://auth.example.com/realms/acclimate","subject":"REPLACE_WITH_KEYCLOAK_USER_ID"}]
# Required JSON; use [] for no static machine credentials.
ACCLIMATE_AUTH=[]
# Optional OpenAI-compatible optimizer. Leave endpoint unset to disable it.
# When endpoint is set, model and nonempty token are required.
# ACCLIMATE_MODEL_ENDPOINT=https://provider.example/v1/chat/completions
# ACCLIMATE_MODEL_TOKEN=REPLACE_WITH_PROVIDER_TOKEN
# ACCLIMATE_MODEL=gpt-6.2-astra
# No default reasoning effort. Accepted: low, medium, high, xhigh, max, ultra.
# ACCLIMATE_MODEL_REASONING_EFFORT=high
# Optimizer request defaults:
# ACCLIMATE_MODEL_TIMEOUT_SECONDS=600
# ACCLIMATE_MODEL_MAX_COMPLETION_TOKENS=32768

# Learning worker defaults:
# ACCLIMATE_LEARNING_MAX_FAILED_ROUNDS=3
# Required for workspace model providers: 64 hex characters that encrypt provider keys.
# The service refuses to start with a different key than the one it first stored a check for.
# ACCLIMATE_PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Exact hostnames a provider may reach over plain HTTP or at a loopback, private, carrier-grade NAT
# or unique-local address. Set the same value on the executor.
# ACCLIMATE_PROVIDER_HTTP_HOSTS=

# Optional invitation SMTP. Absent configuration disables email invitations.
# ACCLIMATE_CONSOLE_ORIGIN=https://console.example.com
# ACCLIMATE_SMTP_HOST=smtp.example.com
# Default port is 465 with tls, 587 otherwise.
# ACCLIMATE_SMTP_PORT=587
# ACCLIMATE_SMTP_FROM=Acclimate <noreply@example.com>
# Default TLS mode is starttls. Username and password are optional as a pair.
# ACCLIMATE_SMTP_TLS=starttls
# ACCLIMATE_SMTP_USERNAME=REPLACE_PRIVATELY
# ACCLIMATE_SMTP_PASSWORD=REPLACE_PRIVATELY
# Local Mailpit settings: deploy/mailpit.md
