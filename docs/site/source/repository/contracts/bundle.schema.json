{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acclimate.local/bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "text"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "enum": [
              "instruction",
              "skill",
              "memory"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 262144
          }
        }
      }
    }
  }
}
