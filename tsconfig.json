{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "scripts/*.ts",
    "tools/**/*.ts",
    "scripts/full-roadmap/**/*.ts"
  ]
}
