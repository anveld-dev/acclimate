{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@anveld/acclimate-sdk": ["./packages/sdk/src/index.ts"],
      "@anveld/acclimate-sdk/validation": ["./packages/sdk/src/validation.ts"],
      "@anveld/acclimate-sdk/native-files": ["./packages/sdk/src/native-files.ts"],
      "@anveld/acclimate-claude-plugin": ["./packages/claude-plugin/src/index.ts"],
      "@anveld/acclimate-claude-plugin/native": ["./packages/claude-plugin/src/native.ts"],
      "@anveld/acclimate-codex-plugin": ["./packages/codex-plugin/src/index.ts"],
      "@anveld/acclimate-cursor-plugin": ["./packages/cursor-plugin/src/index.ts"],
      "@anveld/acclimate-cursor-plugin/native": ["./packages/cursor-plugin/src/native.ts"],
      "@anveld/acclimate-pi-plugin": ["./packages/pi-plugin/src/index.ts"],
      "@anveld/acclimate-pi-plugin/native": ["./packages/pi-plugin/src/native.ts"],
      "@anveld/acclimate-ai-sdk-plugin": ["./packages/ai-sdk-plugin/src/index.ts"],
      "@anveld/acclimate-openai-agents-plugin": ["./packages/openai-agents-plugin/src/index.ts"],
      "@anveld/acclimate-langchain-plugin": ["./packages/langchain-plugin/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts", "scripts/*.ts"],
  "exclude": ["examples/self-improvement-memory", "node_modules", "**/dist"]
}
